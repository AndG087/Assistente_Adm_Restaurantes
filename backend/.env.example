# Copie este arquivo para backend/.env e ajuste os valores.
# O .env nunca deve ser versionado.

# Banco MySQL local (usuário dedicado da aplicação, nunca o root)
DATABASE_URL=mysql+pymysql://restaurante_app:TROQUE_A_SENHA@localhost:3306/restaurante_admin

# Banco exclusivo dos testes automatizados. O nome PRECISA terminar em _test:
# as tabelas dele são apagadas e recriadas a cada execução do pytest.
TEST_DATABASE_URL=mysql+pymysql://restaurante_app:TROQUE_A_SENHA@localhost:3306/restaurante_admin_test

# Sessão de login
SESSAO_DURACAO_HORAS=12
# Deixe false enquanto a aplicação rodar em HTTP local; true exige HTTPS.
COOKIE_SEGURO=false

# Ollama (IA local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# Tempo máximo, em segundos, para o modelo gerar uma resposta
OLLAMA_TIMEOUT_SECONDS=120
# Tempo máximo, em segundos, da checagem de status do Ollama
OLLAMA_STATUS_TIMEOUT_SECONDS=3
# Por quantos segundos o status do Ollama fica em cache
OLLAMA_STATUS_CACHE_SECONDS=10
